# ==============================================================================
# ITC Brand Marketing AI Agent — Environment Configuration
# ==============================================================================

# Google Cloud Project & Location for Vertex AI Agent Engine Deployment & Storage
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Dedicated Google Cloud Storage Bucket for Marketing Assets
# If left blank, defaults automatically to: itc-brand-marketing-assets-${GOOGLE_CLOUD_PROJECT}
# GCS_BUCKET_NAME=your-custom-bucket-name

# Optional: Google AI Studio API Key (Only needed if running without Vertex AI ADC credentials)
# GEMINI_API_KEY=your_gemini_api_key_here
